{
  "autoMemoryEnabled": false,
  "env": {
    "PYTHONUTF8": "1"
  },
  "permissions": {
    "ask": [
      "Bash(* --answer *)",
      "Bash(*SETUP_TOOL_COMMIT*)",
      "Bash(*import tools*)",
      "Bash(*from tools.*)",
      "Bash(*from tools import*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m tools.progress status",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m tools.memory_index show",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python -m tools.timing start",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -m tools.pre_write",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -m tools.agent_guard bash",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -m tools.agent_guard edit",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python -m tools.timing end",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -m tools.post_write",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
